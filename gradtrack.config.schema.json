{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gradtrack config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "program": {
      "type": "object",
      "properties": {
        "degree": { "type": "string" },
        "total_credits": { "type": "number" },
        "competencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "group": { "enum": ["core", "concentration", "other"] },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "source_path": { "type": "string" }
            },
            "required": ["id", "label"]
          }
        },
        "comp_exam_rules": {
          "type": "object",
          "properties": {
            "timing": { "type": "string" },
            "rubric_dimensions": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "graduation": {
      "type": "object",
      "properties": {
        "target_term": { "type": "string" },
        "term_ends": { "type": "object", "additionalProperties": { "type": "string" } },
        "deadline_offset_days": { "type": "number" }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["todo", "in-progress", "done"] },
          "category": { "enum": ["admin", "artifact", "review", "submission"] },
          "blocking": { "type": "boolean" }
        },
        "required": ["id", "label"]
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "programInfo": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" }
          }
        },
        "obsidian": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "schoolDir": { "type": "string" },
            "courseToCompetency": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "username": { "type": "string" },
            "securityThemed": { "type": "boolean" }
          }
        },
        "blog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "dirs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "collection": { "enum": ["blog", "intel"] }
                },
                "required": ["path"]
              }
            }
          }
        },
        "canvas": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "snapshotDir": { "type": "string" },
            "courseId": { "type": "string" },
            "lookbackDays": { "type": "number" }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "outDir": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "accent": { "type": "string" },
        "accentSoft": { "type": "string" },
        "accentAlt": { "type": "string" },
        "accentAltSoft": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "port": { "type": "number" },
        "allowedHosts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
