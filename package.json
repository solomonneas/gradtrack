{
  "name": "gradtrack",
  "version": "0.1.0",
  "description": "Track graduation requirements and ePortfolio progress from configurable sources into a single-pane status site.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gradtrack": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "site:build": "pnpm --filter ./site build",
    "site:preview": "pnpm --filter ./site preview",
    "site:dev": "pnpm --filter ./site dev"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.3",
    "pino": "^9.5.0",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
